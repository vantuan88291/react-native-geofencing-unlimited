<?xml version="1.0" encoding="UTF-8"?>
<!--
  Crosses the seeded dense cluster west-to-east in 10 m steps.

  This is the §4.3 DEGENERATE CASE, and it is expected to be imperfect. 25 regions
  sit inside ~120 m, which is more than iOS has slots for, so
  `safeZone - BOUNDARY_SAFETY_MARGIN_M` falls below MIN_BOUNDARY_RADIUS_M and the
  clamp produces a 500 m boundary that OVERLAPS excluded regions. A missed ENTER
  here is the documented cost of a 20-region budget, not a bug.

  What to watch:
    - The module logs a "dense geofence cluster" warning (needs `debug: true`).
    - The Boundary panel shows radius 500 m — the clamped minimum.
    - Some cluster regions may never report an ENTER. That is the point of the
      fixture: it makes the limitation visible instead of theoretical.

  Use with: seed "Dense cluster (25 in 120 m)" first.
-->
<gpx version="1.1" creator="react-native-geofencing example" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Dense cluster traverse</name>
    <trkseg>
      <trkpt lat="59.913900" lon="10.746824"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.747003"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.747183"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.747362"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.747541"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.747720"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.747899"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.748078"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.748258"><ele>10</ele></trkpt>
      <trkpt lat="59.913900" lon="10.748437"><ele>10</ele></trkpt>
