<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drives 12 km due north from the seed centre in 150 m steps.

  With the default seeding this crosses roughly a hundred seeded regions and trips the
  1790 m boundary six or seven times, so several full rotations happen along the way.

  What to watch (the §13 phase-5 done condition):
    - `getActiveGeofences()` changes as you move — the armed set must always be the
      nearest N, which the example's Registry panel shows sorted by distance.
    - `onGeofencesChange` fires repeatedly. The Boundary panel's centre and radius
      must update with it; when they stop, rotation has stalled.
    - ENTER/EXIT pairs appear in the event log for the seeded regions you pass
      through.

  Use with: seed "Add 300" first.
  Xcode: Debug > Simulate Location > Add GPX File to Workspace.
  Android emulator: Extended Controls > Location > Routes > Import GPX.
-->
<gpx version="1.1" creator="react-native-geofencing example" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Rotation route — 12 km north</name>
    <trkseg>
      <trkpt lat="59.913900" lon="10.752200"><ele>10</ele></trkpt>
      <trkpt lat="59.915247" lon="10.752200"><ele>10</ele></trkpt>
      <trkpt lat="59.916595" lon="10.752200"><ele>10</ele></trkpt>
      <trkpt lat="59.917942" lon="10.752200"><ele>10</ele></trkpt>
